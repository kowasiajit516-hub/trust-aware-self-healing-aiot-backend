# Copy this file to ".env" in the same folder and fill in your real values.
# NEVER commit the real ".env" file to git.

# ---------------------------------------------------
# MongoDB
# ---------------------------------------------------
# Local MongoDB example:
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas example (if you use cloud MongoDB instead):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

MONGODB_DB_NAME=trust_aware_iot

# ---------------------------------------------------
# FastAPI / App
# ---------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS - comma separated list of allowed origins (frontend URL later)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------
# Auth (Phase 7 - dashboard login/register)
# ---------------------------------------------------
# Generate a real secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------
# Google Sign-In (optional - leave blank to disable)
# ---------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID -> Application type: Web application).
# Add your frontend's origin (e.g. http://localhost:5173) under
# "Authorized JavaScript origins". No redirect URI needed for the
# Identity Services button flow used here.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------
# Logging
# ---------------------------------------------------
LOG_LEVEL=INFO
